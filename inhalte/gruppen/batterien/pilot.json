{
  "id": "batterien",

  "eyebrow": {
    "de": "DPP-Pilot · Batterien",
    "en": "DPP pilot · Batteries"
  },
  "titel": {
    "de": "So sieht ein digitaler Batteriepass aus",
    "en": "What a digital battery passport looks like"
  },
  "einleitung": {
    "de": "Ab dem 18. Februar 2027 braucht jede E-Bike-Batterie, jede Industriebatterie über 2 kWh und jede Fahrzeugbatterie in der EU einen digitalen Batteriepass. Er ist ein elektronischer Datensatz, den man über einen QR-Code auf der Batterie aufruft. Am Beispiel eines E-Bike-Akkus zeigen wir, welche Bauteile welche Daten liefern und was Kundinnen, Werkstätten und Behörden im Pass sehen.",
    "en": "From 18 February 2027, every e-bike battery, every industrial battery above 2 kWh and every electric vehicle battery in the EU needs a digital battery passport. It is an electronic record accessed via a QR code on the battery. Using an e-bike battery as an example, we show which components provide which data and what customers, repair shops and authorities see in the passport."
  },
  "einleitung_quelle": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj/eng#art_77",

  "beispiel_hinweis": {
    "de": "Fiktives Beispiel: Produkt, Hersteller und alle Werte sind erfunden und dienen nur der Veranschaulichung.",
    "en": "Fictitious example: product, manufacturer and all values are made up for illustration only."
  },

  "produkt": {
    "name": "VoltRahmen 625",
    "typ": {
      "de": "E-Bike-Akku (LMT-Batterie)",
      "en": "E-bike battery (LMT battery)"
    },
    "hersteller": "Musterwerk Akkutechnik GmbH",
    "pass_id": "BP-DE-MWA-0625-27-004812",
    "eckdaten": [
      { "label": { "de": "Energie", "en": "Energy" }, "wert": "625 Wh" },
      { "label": { "de": "Spannung", "en": "Voltage" }, "wert": "36 V" },
      { "label": { "de": "Zellen", "en": "Cells" }, "wert": "40 × 21700" },
      { "label": { "de": "Gewicht", "en": "Weight" }, "wert": "3,4 kg" }
    ]
  },

  "schritte": [
    {
      "titel": {
        "de": "QR-Code auf der Batterie",
        "en": "QR code on the battery"
      },
      "text": {
        "de": "Jede Batterie bekommt eine eindeutige Kennung. Der QR-Code führt direkt zu ihrem Pass.",
        "en": "Every battery gets a unique identifier. The QR code leads directly to its passport."
      },
      "quelle": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj/eng#art_77"
    },
    {
      "titel": {
        "de": "Daten aus der Lieferkette",
        "en": "Data from the supply chain"
      },
      "text": {
        "de": "Rohstofflieferanten, Zellhersteller und der Akkuhersteller liefern Daten zu. Verantwortlich für den Pass ist, wer die Batterie in der EU in Verkehr bringt.",
        "en": "Raw material suppliers, cell manufacturers and the battery manufacturer contribute data. The party placing the battery on the EU market is responsible for the passport."
      },
      "quelle": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj/eng#art_77"
    },
    {
      "titel": { "de": "Gestufter Zugriff", "en": "Tiered access" },
      "text": {
        "de": "Manche Daten sind für alle sichtbar. Andere sehen nur Werkstätten, Recycler oder Behörden.",
        "en": "Some data is visible to everyone. Other data is only visible to repairers, recyclers or authorities."
      },
      "zugriffsstufen_zeigen": true,
      "quelle": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj/eng#anx_XIII"
    }
  ],

