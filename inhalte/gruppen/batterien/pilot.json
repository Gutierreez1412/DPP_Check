      "text": {
        "de": "40 Rundzellen bestimmen Kapazität, Spannung und Lebensdauer. Die Leistungsdaten und Testberichte stammen größtenteils vom Zellhersteller.",
        "en": "40 cylindrical cells determine capacity, voltage and lifetime. Performance data and test reports mostly come from the cell manufacturer."
      },
      "lieferant": { "de": "Zellhersteller", "en": "Cell manufacturer" },
      "felder": ["kapazitaet", "spannung", "lebensdauer", "co2", "testberichte"]
