  "schritte": [
    {
      "titel": {
        "de": "QR-Code auf der Batterie",
        "en": "QR code on the battery"
      },
      "text": {
        "de": "Jede Batterie bekommt eine eindeutige Kennung. Der QR-Code führt direkt zu ihrem Pass.",
        "en": "Every battery gets a unique identifier. The QR code leads directly to its passport."
      },
      "quelle": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj/eng#art_77"
    },
    {
      "titel": {
        "de": "Daten aus der Lieferkette",
        "en": "Data from the supply chain"
      },
      "text": {
        "de": "Rohstofflieferanten, Zellhersteller und der Akkuhersteller liefern Daten zu. Verantwortlich für den Pass ist, wer die Batterie in der EU in Verkehr bringt.",
        "en": "Raw material suppliers, cell manufacturers and the battery manufacturer contribute data. The party placing the battery on the EU market is responsible for the passport."
      },
      "quelle": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj/eng#art_77"
    },
    {
      "titel": {
        "de": "Gestufter Zugriff",
        "en": "Tiered access"
      },
      "text": {
        "de": "Manche Daten sind für alle sichtbar. Andere sehen nur Werkstätten, Recycler oder Behörden.",
        "en": "Some data is visible to everyone. Other data is only visible to repairers, recyclers or authorities."
      },
      "zugriffsstufen_zeigen": true,
      "quelle": "https://eur-lex.europa.eu/eli/reg/2023/1542/oj/eng#anx_XIII"
    }
  ],
