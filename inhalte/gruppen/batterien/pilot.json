      "nummer": "05",
      "name": { "de": "Typenschild & QR-Code", "en": "Type plate & QR code" },
      "text": {
        "de": "Auf dem Gehäuseboden sitzt der QR-Code. Er ist der Zugang zum Pass. Dazu kommen CE-Kennzeichnung, Sammelsymbol und die Konformitätserklärung.",
        "en": "The QR code sits on the housing base and is the gateway to the passport. Add to that CE marking, collection symbol and declaration of conformity."
      },
      "lieferant": { "de": "Akkuhersteller", "en": "Battery manufacturer" },
      "felder": [
        "kennung",
        "hersteller",
        "kennzeichen",
        "konformitaet",
        "ruecknahme"
      ]
    }
