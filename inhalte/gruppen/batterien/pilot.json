      "text": {
        "de": "Die Elektronik überwacht Spannung, Temperatur und Ladezyklen. Sie liefert die laufend aktualisierten Daten zum Alterungszustand (State of Health).",
        "en": "The electronics monitor voltage, temperature and charge cycles. They provide the continuously updated state-of-health data."
      },
      "lieferant": {
        "de": "Akkuhersteller / BMS-Zulieferer",
        "en": "Battery manufacturer / BMS supplier"
      },
      "felder": ["soh", "zyklen_aktuell", "status"]
    },
