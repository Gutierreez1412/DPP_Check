---
import Layout from "../../../layouts/Layout.astro";
import Platzhalter from "../../../components/Platzhalter.astro";
import Check from "../../../components/Check.astro";
import filter from "../../../../inhalte/filter.json";
import seite from "../../../../inhalte/seite.json";

export function getStaticPaths() {
  return filter.produktgruppen.map((gruppe) => ({
    params: { id: gruppe.id },
    props: { gruppe },
  }));
}

const { gruppe } = Astro.props;

// Der Check ist freigeschaltet, sobald die Gruppe eine eigene gruppe.json hat.
const gruppenDateien = import.meta.glob(
  "../../../../inhalte/gruppen/*/gruppe.json",
);
const freigeschaltet = Object.keys(gruppenDateien).some((pfad) =>
  pfad.includes(`/gruppen/${gruppe.id}/`),
);
---

<Layout lang="de" title={gruppe.name.de}>
  {
    freigeschaltet ? (
      <Check lang="de" gruppe={gruppe} />
    ) : (
      <Platzhalter
        titel={gruppe.name.de}
        hinweis={seite.platzhalter_checkseite.de}
        zurueckHref={`/de/gruppe/${gruppe.id}/`}
        zurueckLabel={seite.zurueck_zur_gruppe.de}
      />
    )
  }
</Layout>
