---
import Layout from "../../layouts/Layout.astro";
import Filter from "../../components/Filter.astro";
import ProduktpassGrafik from "../../components/ProduktpassGrafik.astro";
import seite from "../../../inhalte/seite.json";
---

<Layout lang="en">
  <div class="hero">
    <div>
      <h1>{seite.titel.en}</h1>
      <p class="lede">{seite.untertitel.en}</p>
      <p class="hinweis-text">{seite.datenschutz_hinweis.en}</p>
    </div>
    <ProduktpassGrafik lang="en" />
  </div>

  <Filter lang="en" />
</Layout>
