---
import filter from "../../inhalte/filter.json";

interface Props {
  lang: "de" | "en";
}

const { lang } = Astro.props;
const t = (feld: Record<"de" | "en", string>) => feld[lang];
const gruppen = filter.produktgruppen;

interface Zweisprachig {
  de: string;
  en: string;
}

interface EigeneFrage {
  id: string;
  titel: Zweisprachig;
  hinweis?: Zweisprachig;
  punkte?: { label?: Zweisprachig; text: Zweisprachig }[];
  bei_ja: string;
  bei_nein: string;
}

interface EigenerFilter {
  gruppe: string;
  fragen: EigeneFrage[];
  schlussergebnis: string;
}

// Gruppen mit eigener Fragenreihe zur Betroffenheit (z. B. Batterien nach
// Batterieverordnung) statt der ESPR-Schritte 2 und 3.
const eigeneModule = import.meta.glob<{ default: EigenerFilter }>(
  "../../inhalte/gruppen/*/filter.json",
  { eager: true },
);
const eigeneFilter = gruppen.flatMap((g) => {
  const daten = Object.values(eigeneModule).find(
    (modul) => modul.default.gruppe === g.id,
  )?.default;
  return daten ? [daten] : [];
});

const texteFuerClient = {
  fehlerKeineAuswahl: t(filter.schritt1.fehler_keine_auswahl),
  fehlerKeineAntwort: t(filter.fehler_keine_antwort),
  fortschrittVorlage: t(filter.fortschritt_vorlage),
  eigene: Object.fromEntries(
    eigeneFilter.map((e) => [
      e.gruppe,
      {
        fragen: e.fragen.map((f) => ({
          id: f.id,
          bei_ja: f.bei_ja,
          bei_nein: f.bei_nein,
        })),
        schlussergebnis: e.schlussergebnis,
      },
    ]),
  ),
};
---

<section class="assistent">
  <p class="fortschritt" id="fortschritt-text" aria-live="polite"></p>
  <div class="fortschrittsbalken">
    <div class="fortschrittsbalken__fuellung" id="fortschrittsbalken"></div>
  </div>

  <form id="filter-formular">
    <fieldset class="schritt" id="schritt-1" data-schritt="1">
      <legend>{t(filter.schritt1.titel)}</legend>
      <p class="hinweis-text">{t(filter.schritt1.hinweis)}</p>
      <div class="optionen">
        {
          gruppen.map((g) => (
            <label class="option">
              <input type="checkbox" name="gruppen" value={g.id} />
              <span>{t(g.name)}</span>
            </label>
          ))
        }
      </div>
      <p class="fehler" id="fehler-1" role="alert" hidden></p>
      <div class="aktionen">
        <button type="button" class="button" data-weiter="1"
          >{t(filter.buttons.weiter)}</button
        >
      </div>
    </fieldset>

    <fieldset
      class="schritt"
      id="schritt-2"
      data-schritt="2"
      data-abschnitt="espr"
      hidden
    >
      <legend>{t(filter.schritt2.titel)}</legend>
      <div class="optionen">
        <label class="option">
          <input type="radio" name="eigener_name" value="ja" />
          <span>{t(filter.antworten.ja)}</span>
        </label>
        <label class="option">
          <input type="radio" name="eigener_name" value="nein" />
          <span>{t(filter.antworten.nein)}</span>
        </label>
      </div>
      <p class="fehler" id="fehler-2" role="alert" hidden></p>
      <div class="aktionen">
        <button type="button" class="button button--sekundaer" data-zurueck="2"
          >{t(filter.buttons.zurueck)}</button
        >
        <button type="button" class="button" data-weiter="2"
          >{t(filter.buttons.weiter)}</button
        >
      </div>
    </fieldset>

    <fieldset
      class="schritt"
      id="schritt-3"
      data-schritt="3"
      data-abschnitt="espr"
      hidden
    >
      <legend>{t(filter.schritt3.titel)}</legend>
      <p class="hinweis-text">{t(filter.schritt3.hinweis)}</p>
      <div class="optionen">
        <label class="option">
          <input type="radio" name="wesentliche_aenderung" value="ja" />
          <span>{t(filter.antworten.ja)}</span>
        </label>
        <label class="option">
          <input type="radio" name="wesentliche_aenderung" value="nein" />
          <span>{t(filter.antworten.nein)}</span>
        </label>
      </div>
      <p class="fehler" id="fehler-3" role="alert" hidden></p>
      <div class="aktionen">
        <button type="button" class="button button--sekundaer" data-zurueck="3"
          >{t(filter.buttons.zurueck)}</button
        >
        <button type="button" class="button" data-weiter="3"
          >{t(filter.buttons.weiter)}</button
        >
      </div>
    </fieldset>

    {
      eigeneFilter.flatMap((e) =>
        e.fragen.map((f) => {
          const schrittId = `${e.gruppe}-${f.id}`;
          // Einheitliche Schriftgröße je Gruppe: sobald eine Frage lang ist,
          // gelten alle Fragen der Gruppe als lang.
          const gruppeHatLangeFrage = e.fragen.some(
            (x) => x.titel.de.length > 90,
          );
          return (
            <fieldset
              class:list={[
                "schritt",
                { "schritt--lang": gruppeHatLangeFrage },
              ]}
              id={`schritt-${schrittId}`}
              data-abschnitt={e.gruppe}
              data-frage={f.id}
              hidden
            >
              <legend set:html={t(f.titel)} />
              {f.punkte && (
                <ul class="punkte">
                  {f.punkte.map((p) => (
                    <li>
                      {p.label && <strong>{t(p.label)}</strong>}
                      <span>{t(p.text)}</span>
                    </li>
                  ))}
                </ul>
              )}
              {f.hinweis && <p class="hinweis-text">{t(f.hinweis)}</p>}
              <div class="optionen">
                <label class="option">
                  <input type="radio" name={schrittId} value="ja" />
                  <span>{t(filter.antworten.ja)}</span>
                </label>
                <label class="option">
                  <input type="radio" name={schrittId} value="nein" />
                  <span>{t(filter.antworten.nein)}</span>
                </label>
              </div>
              <p
                class="fehler"
                id={`fehler-${schrittId}`}
                role="alert"
                hidden
              />
              <div class="aktionen">
                <button
                  type="button"
                  class="button button--sekundaer"
                  data-zurueck
                >
                  {t(filter.buttons.zurueck)}
                </button>
                <button type="button" class="button" data-weiter>
                  {t(filter.buttons.weiter)}
                </button>
              </div>
            </fieldset>
          );
        }),
      )
    }
  </form>
</section>

<script
  type="application/json"
  id="filter-texte"
  set:html={JSON.stringify(texteFuerClient)}
/>

<script>
  function initFilter() {
    const form = document.getElementById("filter-formular");
    const texteEl = document.getElementById("filter-texte");
    if (!(form instanceof HTMLFormElement) || !texteEl) return;

    const lang = document.documentElement.lang || "de";
    const texte = JSON.parse(texteEl.textContent || "{}");
    const reduzierteBewegung = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    const schritte = Array.from(
      form.querySelectorAll<HTMLFieldSetElement>(".schritt"),
    );
    const eigene: Record<
      string,
      {
        fragen: { id: string; bei_ja: string; bei_nein: string }[];
        schlussergebnis: string;
      }
    > = texte.eigene || {};
    const fortschrittText = document.getElementById("fortschritt-text");
    const fortschrittBalken = document.getElementById("fortschrittsbalken");

    const state: {
      gruppen: string[];
      eigenerName: string | null;
      wesentlicheAenderung: string | null;
      ergebnisse: Record<string, string>;
    } = {
      gruppen: [],
      eigenerName: null,
      wesentlicheAenderung: null,
      ergebnisse: {},
    };
    // Besuchte Schritte, damit "Zurück" auch nach Verzweigungen stimmt.
    const verlauf: HTMLFieldSetElement[] = [];

    // ESPR-Schritte brauchen nur Gruppen ohne eigene Fragenreihe.
    function hatEspr() {
      return state.gruppen.some((g) => !(g in eigene));
    }

    function abschnitte() {
      const eigeneGewaehlt = Object.keys(eigene).filter((g) =>
        state.gruppen.includes(g),
      );
      return hatEspr() ? ["espr", ...eigeneGewaehlt] : eigeneGewaehlt;
    }

    function gesamtSchritte() {
      if (state.gruppen.length === 0) return 3;
      const folgeschritte = abschnitte().reduce(
        (summe, a) =>
          summe + schritte.filter((s) => s.dataset.abschnitt === a).length,
        0,
      );
      return 1 + folgeschritte;
    }

    function anzeigen(aktiv: HTMLFieldSetElement) {
      schritte.forEach((el) => {
        const istAktiv = el === aktiv;
        el.hidden = !istAktiv;
        if (istAktiv) {
          el.classList.remove("eintritt");
          if (!reduzierteBewegung) {
            void el.offsetWidth;
            el.classList.add("eintritt");
          }
        }
      });
      const n = verlauf.length;
      const gesamt = Math.max(gesamtSchritte(), n);
      if (fortschrittText) {
        fortschrittText.textContent = texte.fortschrittVorlage
          .replace("{n}", String(n))
          .replace("{gesamt}", String(gesamt));
      }
      if (fortschrittBalken instanceof HTMLElement) {
        fortschrittBalken.style.width = `${(n / gesamt) * 100}%`;
      }
      const legende = aktiv.querySelector("legend");
      if (legende instanceof HTMLElement) {
        legende.setAttribute("tabindex", "-1");
        legende.focus();
      }
    }

    function gehZu(schritt: HTMLFieldSetElement | undefined) {
      if (!schritt) return;
      verlauf.push(schritt);
      anzeigen(schritt);
    }

    function zurueck() {
      if (verlauf.length < 2) return;
      verlauf.pop();
      anzeigen(verlauf[verlauf.length - 1]);
    }

    function zeigeFehler(schritt: HTMLFieldSetElement, nachricht: string) {
      const fehlerEl = schritt.querySelector<HTMLElement>(".fehler");
      if (fehlerEl) {
        fehlerEl.textContent = nachricht;
        fehlerEl.hidden = false;
      }
    }

    function versteckeFehler(schritt: HTMLFieldSetElement) {
      const fehlerEl = schritt.querySelector<HTMLElement>(".fehler");
      if (fehlerEl) fehlerEl.hidden = true;
    }

    function ermittleRolle() {
      if (state.eigenerName === "ja") return "hersteller";
      if (state.wesentlicheAenderung === "ja") return "hersteller_screening";
      return "importeur_vertreiber";
    }

    function weiterleiten() {
      const params = new URLSearchParams();
      if (hatEspr()) params.set("rolle", ermittleRolle());
      Object.entries(state.ergebnisse).forEach(([gruppe, ergebnis]) => {
        if (state.gruppen.includes(gruppe)) {
          params.set(`rolle_${gruppe}`, ergebnis);
        }
      });
      if (state.gruppen.length === 1) {
        window.location.href = `/${lang}/gruppe/${state.gruppen[0]}/?${params}`;
        return;
      }
      window.location.href = `/${lang}/uebersicht/?gruppen=${state.gruppen.join(",")}&${params}`;
    }

    // Nach einem Abschnitt (ESPR oder eigene Fragenreihe) folgt der nächste
    // gewählte Abschnitt, nach dem letzten die Weiterleitung.
    function weiterNach(abschnitt: string | null) {
      const liste = abschnitte();
      const naechster =
        liste[abschnitt === null ? 0 : liste.indexOf(abschnitt) + 1];
      if (!naechster) {
        weiterleiten();
        return;
      }
      gehZu(schritte.find((s) => s.dataset.abschnitt === naechster));
    }

    function auswertenEigene(schritt: HTMLFieldSetElement, antwort: string) {
      const abschnitt = schritt.dataset.abschnitt || "";
      const { fragen, schlussergebnis } = eigene[abschnitt];
      const index = fragen.findIndex((f) => f.id === schritt.dataset.frage);
      const ziel =
        antwort === "ja" ? fragen[index].bei_ja : fragen[index].bei_nein;
      if (ziel !== "weiter") {
        state.ergebnisse[abschnitt] = ziel;
        weiterNach(abschnitt);
        return;
      }
      const naechste = fragen[index + 1];
      if (naechste) {
        gehZu(
          schritte.find((s) => s.id === `schritt-${abschnitt}-${naechste.id}`),
        );
        return;
      }
      state.ergebnisse[abschnitt] = schlussergebnis;
      weiterNach(abschnitt);
    }

    function weiter(schritt: HTMLFieldSetElement) {
      if (schritt.id === "schritt-1") {
        const ausgewaehlt = Array.from(
          form!.querySelectorAll<HTMLInputElement>(
            'input[name="gruppen"]:checked',
          ),
        ).map((el) => el.value);
        if (ausgewaehlt.length === 0) {
          zeigeFehler(schritt, texte.fehlerKeineAuswahl);
          return;
        }
        state.gruppen = ausgewaehlt;
        versteckeFehler(schritt);
        weiterNach(null);
        return;
      }

      const antwort = schritt.querySelector<HTMLInputElement>(
        'input[type="radio"]:checked',
      );
      if (!antwort) {
        zeigeFehler(schritt, texte.fehlerKeineAntwort);
        return;
      }
      versteckeFehler(schritt);

      if (schritt.id === "schritt-2") {
        state.eigenerName = antwort.value;
        gehZu(schritte.find((s) => s.id === "schritt-3"));
      } else if (schritt.id === "schritt-3") {
        state.wesentlicheAenderung = antwort.value;
        weiterNach("espr");
      } else {
        auswertenEigene(schritt, antwort.value);
      }
    }

    form.addEventListener("click", (ereignis) => {
      const ziel = ereignis.target;
      if (!(ziel instanceof Element)) return;
      const schritt = ziel.closest<HTMLFieldSetElement>(".schritt");
      if (!schritt) return;
      if (ziel.closest("[data-zurueck]")) zurueck();
      else if (ziel.closest("[data-weiter]")) weiter(schritt);
    });

    gehZu(schritte[0]);
  }

  initFilter();
</script>
