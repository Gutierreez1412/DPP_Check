---
import { QUELLEN_ANZEIGEN } from "../config";
import seite from "../../inhalte/seite.json";
import RollenHinweis from "./RollenHinweis.astro";
import Beratungsformular from "./Beratungsformular.astro";

interface Zweisprachig {
  de: string;
  en: string;
}

interface Meilenstein {
  datum: string;
  titel: Zweisprachig;
  beschreibung: Zweisprachig;
  status: "gilt" | "geplant" | "unklar";
  quelle: string;
}

interface FaqEintrag {
  frage: Zweisprachig;
  antwort: Zweisprachig;
  quelle: string;
}

export interface GruppenDaten {
  id: string;
  name: Zweisprachig;
  definition: Zweisprachig;
  definition_quelle: string;
  weiterfuehrend?: { label: Zweisprachig; url: string };
  // Hinweis, wenn Inhalte noch auf keinem Rechtsakt beruhen (z. B. Vorstudie).
  vorbehalt?: { titel: Zweisprachig; text: Zweisprachig; quelle: string };
  zeitstrahl: Meilenstein[];
  faq: FaqEintrag[];
}

interface Props {
  lang: "de" | "en";
  daten: GruppenDaten;
  /** Die Seite zeigt den Titel schon selbst (Hero) */
  ohneTitel?: boolean;
}

const { lang, daten, ohneTitel = false } = Astro.props;
const t = (feld: Zweisprachig) => feld[lang];
const quelleLabel = t(seite.quelle_label);
---

<section>
  {ohneTitel ? null : <h1 class="nur-screenreader">{t(daten.name)}</h1>}
  <RollenHinweis
    lang={lang}
    gruppeId={daten.id}
    ohneEinschaetzung={Boolean(daten.vorbehalt)}
  />

  {
    daten.vorbehalt && (
      <aside class="hinweisbox hinweisbox--vorbehalt">
        <p class="hinweisbox__titel">{t(daten.vorbehalt.titel)}</p>
        {t(daten.vorbehalt.text)
          .split("\n")
          .map((absatz, i, alle) => (
            <p>
              {absatz}
              {QUELLEN_ANZEIGEN && i === alle.length - 1 && (
                <>
                  {" "}
                  <a
                    href={daten.vorbehalt!.quelle}
                    target="_blank"
                    rel="noopener"
                  >
                    {quelleLabel}
                  </a>
                </>
              )}
            </p>
          ))}
      </aside>
    )
  }

  <div class="cta-band">
    <div class="cta-band__text">
      <h2>{t(seite.cta_titel)}</h2>
      <p>{t(seite.cta_text)}</p>
    </div>
    <div class="cta-band__aktion">
      <a class="button button--hell" href={`/${lang}/check/${daten.id}/`}
        >{t(seite.check_button)}</a
      >
      <a class="cta-band__link" href="#beratung">{t(seite.cta_beratung_link)}</a
      >
    </div>
  </div>

  <div class="block">
    <h2>{t(seite.definition_titel)}</h2>
    <div class="block__inhalt">
      <p class="definition">{t(daten.definition)}</p>
      <p class="quelle-hinweis" hidden={!QUELLEN_ANZEIGEN}>
        {
          QUELLEN_ANZEIGEN && (
            <a href={daten.definition_quelle} target="_blank" rel="noopener">
              {quelleLabel}
            </a>
          )
        }
        {
          QUELLEN_ANZEIGEN && daten.weiterfuehrend && (
            <>
              {" · "}
              <a href={daten.weiterfuehrend.url} target="_blank" rel="noopener">
                {t(daten.weiterfuehrend.label)}
              </a>
            </>
          )
        }
      </p>
    </div>
  </div>

  <section class="zeitstrahl-block">
    <h2>{t(seite.zeitstrahl_titel)}</h2>
    <ol class="zeitstrahl" style={`--anzahl:${daten.zeitstrahl.length}`}>
      {
        daten.zeitstrahl.map((m) => (
          <li
            class="zeitstrahl__eintrag"
            data-status={m.status}
            data-datum={m.datum}
          >
            <span class="zeitstrahl__datum">{m.datum}</span>
            <span class={`status-badge status-badge--${m.status}`}>
              {t(seite.status_label[m.status])}
            </span>
            <strong>{t(m.titel)}</strong>
            <p>{t(m.beschreibung)}</p>
            {QUELLEN_ANZEIGEN && (
              <a href={m.quelle} target="_blank" rel="noopener">
                {quelleLabel}
              </a>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <div class="block">
    <h2>{t(seite.faq_titel)}</h2>
    <div class="block__inhalt">
      <div class="faq-liste">
        {
          daten.faq.map((f) => (
            <details class="faq-eintrag">
              <summary>{t(f.frage)}</summary>
              <p>{t(f.antwort)}</p>
              {QUELLEN_ANZEIGEN && (
                <a href={f.quelle} target="_blank" rel="noopener">
                  {quelleLabel}
                </a>
              )}
            </details>
          ))
        }
      </div>
    </div>
  </div>

  <Beratungsformular lang={lang} gruppenName={t(daten.name)} mitPerson />

  <div class="aktionen aktionen--landingpage">
    <a class="button" href={`/${lang}/check/${daten.id}/`}
      >{t(seite.check_button)}</a
    >
    <a class="button button--sekundaer" href={`/${lang}/filter/`}
      >{t(seite.zurueck_zur_auswahl)}</a
    >
  </div>
</section>

<script>
  // Marker nach Datum: gefüllt = vorbei, hohl = kommt noch. Nur ISO-Datum
  // (JJJJ-MM-TT) oder Jahr; "TBD" o. Ä. bleibt ohne Datum (Marker nach Status).
  const zeitpunkt = (text: string) => {
    const m = /^(\d{4})(?:-(\d{2})-(\d{2}))?$/.exec(text.trim());
    return m ? new Date(+m[1], m[2] ? +m[2] - 1 : 0, m[3] ? +m[3] : 1) : null;
  };
  const jetzt = new Date();
  document
    .querySelectorAll<HTMLElement>(".zeitstrahl__eintrag[data-datum]")
    .forEach((el) => {
      const z = zeitpunkt(el.dataset.datum ?? "");
      if (z) el.dataset.zeit = z > jetzt ? "kommt" : "vorbei";
    });
</script>
