---
import { QUELLEN_ANZEIGEN } from "../config";
import grundlagen from "../../inhalte/grundlagen.json";
import seite from "../../inhalte/seite.json";

interface Props {
  lang: "de" | "en";
}

const { lang } = Astro.props;
const t = (feld: Record<"de" | "en", string>) => feld[lang];
const cta = seite.startseite.cta;
---

<section class="grundlagen" aria-labelledby="grundlagen-titel">
  <div class="grundlagen__intro">
    <span class="tag tag-stand">{t(grundlagen.stand)}</span>
    <h2 id="grundlagen-titel">{t(grundlagen.titel)}</h2>
    <p class="grundlagen__lead">
      {t(grundlagen.einleitung.text)}
      {
        QUELLEN_ANZEIGEN && (
          <a href={grundlagen.einleitung.quelle} target="_blank" rel="noopener">
            {t(seite.quelle_label)}
          </a>
        )
      }
    </p>
    <hr class="grundlagen__linie" />
    <p class="grundlagen__fuss">{t(grundlagen.fuss)}</p>
    <a class="button" href={cta.link[lang]}>{cta.text[lang]} →</a>
  </div>
  <ul class="grundlagen__raster">
    {
      grundlagen.abschnitte.map((a) => (
        <li
          class={`grundlagen-karte${a.dunkel ? " grundlagen-karte--dunkel" : ""}`}
        >
          <span class="tag">{t(a.tag)}</span>
          <h3>{t(a.ueberschrift)}</h3>
          <p class="grundlagen-karte__kern">{t(a.kern)}</p>
          <p class="grundlagen-karte__text">{t(a.text)}</p>
          {QUELLEN_ANZEIGEN && (
            <a href={a.quelle} target="_blank" rel="noopener">
              {t(seite.quelle_label)}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>
