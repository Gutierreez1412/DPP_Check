---
/*
  Grafiken für den Textil-Pilot: Hero-Szene (Hoodie auf dem Bügel, Sucher auf
  dem Nackenetikett) und Explosionszeichnung des flach liegenden Hoodies in
  isometrischer Projektion: Stoff, Nähte mit Kordel und Metallösen sowie
  Etikett mit QR-Code als Ebenen.
  Gleiches Prinzip wie beim Akku: --zu ist der Versatz in den zusammengebauten
  Zustand, beim Laden fährt das Shirt auseinander.
*/
import SzenePanel from "./SzenePanel.astro";
import {
  cos30,
  hotspotIn,
  iso,
  pt,
  qrKlein,
  zufallAus,
  type ViewBox,
} from "./geometrie";

interface Props {
  teil: "szene" | "explosion";
  lang: "de" | "en";
  pilot: {
    produkt: { name: string; eckdaten: { wert: string }[] };
    komponenten: {
      id: string;
      ebene: string;
      nummer: string;
      name: Record<"de" | "en", string>;
    }[];
    texte: Record<
      "szene_label" | "szene_schild" | "szene_scan",
      Record<"de" | "en", string>
    >;
  };
  aktiv: string;
}

const { teil, lang, pilot, aktiv } = Astro.props;
const t = (feld: Record<"de" | "en", string>) => feld[lang];

// Flach liegender Hoodie in Ebenen-Koordinaten (u quer, v längs, Kapuze oben):
// Kapuze, lange Ärmel mit Bündchen, Körper.
const hoodie = [
  [110, -26],
  [124, -23],
  [136, -14],
  [140, 0],
  [137, 10],
  [170, 16],
  [226, 60],
  [238, 138],
  [216, 142],
  [205, 92],
  [170, 84],
  [170, 200],
  [50, 200],
  [50, 84],
  [15, 92],
  [4, 142],
  [-18, 138],
  [-6, 60],
  [50, 16],
  [83, 10],
  [80, 0],
  [84, -14],
  [96, -23],
];
const Z = { stoff: 0, naehte: 90, etikett: 170 };
const flaeche = (z: number) => hoodie.map(([u, v]) => pt(u, v, z)).join(" ");
const linie = (punkte: number[][], z: number) =>
  "M" + punkte.map(([u, v]) => pt(u, v, z).replace(",", " ")).join("L");

// Maschenreihen des Sweatstoffs, auf die Hoodie-Form zugeschnitten.
const reihen = Array.from({ length: 29 }, (_, k) =>
  linie(
    [
      [-20, -24 + k * 8],
      [240, -24 + k * 8],
    ],
    Z.stoff,
  ),
).join("");

// Nähte: Kapuzenansatz, Ärmel- und Seitennähte, Saum, Ärmelbündchen, Känguru-Tasche.
const naehte = [
  [
    [83, 10],
    [96, 22],
    [110, 28],
    [124, 22],
    [137, 10],
  ],
  [
    [50, 16],
    [50, 200],
  ],
  [
    [170, 16],
    [170, 200],
  ],
  [
    [50, 186],
    [170, 186],
  ],
  [
    [-14.6, 116],
    [8.8, 120],
  ],
  [
    [234.6, 116],
    [211.2, 120],
  ],
  [
    [80, 120],
    [70, 172],
    [150, 172],
    [140, 120],
  ],
]
  .map((p) => linie(p, Z.naehte))
  .join("");

// Kordel durch die Kapuze und Metallösen am Kapuzenansatz.
const kordel = [
  [
    [101, 32],
    [99, 50],
    [100, 70],
    [98, 96],
  ],
  [
    [119, 32],
    [121, 50],
    [120, 70],
    [122, 92],
  ],
]
  .map((p) => linie(p, Z.naehte))
  .join("");
const oesen = [101, 119].map((u) =>
  Array.from({ length: 12 }, (_, k) => {
    const w = (k / 12) * 2 * Math.PI;
    return pt(u + 2.8 * Math.cos(w), 32 + 2.8 * Math.sin(w), Z.naehte);
  }).join(" "),
);

// Nackenetikett: lokales Koordinatensystem auf der Ebene (a entlang u, b entlang v).
const etikett = { u: 86, v: 10, b: 48, h: 24 };
const [ex, ey] = iso(etikett.u, etikett.v, Z.etikett);
const etikettMatrix = `matrix(${cos30.toFixed(4)} 0.5 ${(-cos30).toFixed(4)} 0.5 ${ex.toFixed(1)} ${ey.toFixed(1)})`;
const qrModule = qrKlein(zufallAus(160), 2.5, 2.5, 2.7);

const fuehrung = [
  [-18, 138, Z.naehte],
  [238, 138, Z.naehte],
  [50, 200, Z.naehte],
  [170, 200, Z.naehte],
  [110, 14, Z.etikett],
].map(([u, v, z]) => ({ von: iso(u, v, Z.stoff), bis: iso(u, v, z) }));

const vb: ViewBox = { x: -160, y: -150, b: 330, h: 355 };
const hotspot = hotspotIn(vb);
const hotspotPos: Record<string, string> = {
  etikett: hotspot(etikett.u + etikett.b / 2, etikett.v + 4, Z.etikett),
  naehte: hotspot(119, 40, Z.naehte),
  stoff: hotspot(110, 115, Z.stoff),
  farbe: hotspot(150, 178, Z.stoff),
};
const versatz: Record<string, number> = {
  stoff: 0,
  naehte: Z.naehte - 2,
  etikett: Z.etikett - 1,
};

// Hero-Szene: Hoodie auf dem Bügel, das Etikett im Nacken ist markiert.
const sucher = { x: 96, y: 13, b: 48, h: 36 };
---

{
  teil === "szene" ? (
    <svg
      viewBox="0 0 400 132"
      role="img"
      aria-label={t(pilot.texte.szene_label)}
    >
      <defs>
        <linearGradient id="szene-strahl-verlauf" x1="0" x2="1">
          <stop offset="0" stop-color="#45d4c0" stop-opacity="0.2" />
          <stop offset="1" stop-color="#45d4c0" stop-opacity="0.02" />
        </linearGradient>
      </defs>

      <path
        class="szene__linie szene__linie--duenn"
        pathLength="1"
        d="M120 13V9Q120 6 123 4.5Q126 3 125.5 1M120 20L88 34H152Z"
      />
      <path
        class="szene__linie"
        pathLength="1"
        d="M104 29Q120 41 136 29L150 33L166 40L174 112H162L160 62H152V116H88V62H80L78 112H66L74 40L90 33Z"
      />
      <path
        class="szene__linie szene__linie--duenn"
        pathLength="1"
        d="M104 29Q98 14 120 13Q142 14 136 29"
      />
      <path
        class="szene__speichen"
        d="M113 36V54M127 36V52M67 104H77M163 104H173M88 109H152M96 86L92 108M144 86L148 108M96 86H144"
      />
      <circle class="szene__oese" cx="113" cy="35" r="1.6" />
      <circle class="szene__oese" cx="127" cy="35" r="1.6" />
      <g class="szene__akku">
        <rect x="114" y="19" width="12" height="7" rx="1.5" />
      </g>

      <SzenePanel
        sucher={sucher}
        name={pilot.produkt.name}
        daten={pilot.produkt.eckdaten.map((d) => d.wert)}
        schild={t(pilot.texte.szene_schild)}
        scan={t(pilot.texte.szene_scan)}
        seed={2027}
      />
    </svg>
  ) : (
    <div
      class="explosion explosion--textil"
      id="explosion"
      data-aktiv={aktiv}
      style={`aspect-ratio:${vb.b} / ${vb.h}`}
    >
      <svg
        viewBox={`${vb.x} ${vb.y} ${vb.b} ${vb.h}`}
        role="img"
        aria-label={pilot.produkt.name}
      >
        <defs>
          <pattern
            id="raster"
            width="24"
            height="24"
            patternUnits="userSpaceOnUse"
          >
            <path d="M24 0H0V24" class="explosion__raster" />
          </pattern>
          <clipPath id="hoodie-form">
            <polygon points={flaeche(Z.stoff)} />
          </clipPath>
        </defs>
        <rect
          x={vb.x}
          y={vb.y}
          width={vb.b}
          height={vb.h}
          fill="url(#raster)"
        />

        <g class="explosion__fuehrung">
          {fuehrung.map((f) => (
            <line x1={f.von[0]} y1={f.von[1]} x2={f.bis[0]} y2={f.bis[1]} />
          ))}
        </g>

        <g class="ebene" data-ebene="stoff" style="--zu:0px">
          <polygon
            class="flaeche flaeche--links"
            points={flaeche(Z.stoff - 5)}
          />
          <polygon
            class="flaeche flaeche--oben stoff"
            points={flaeche(Z.stoff)}
          />
          <path
            class="stoff__reihen"
            d={reihen}
            clip-path="url(#hoodie-form)"
          />
        </g>

        <g class="ebene" data-ebene="naehte" style={`--zu:${versatz.naehte}px`}>
          <polygon
            class="flaeche flaeche--innen naehte__umriss"
            points={flaeche(Z.naehte)}
          />
          <path class="naehte__linie" d={naehte} />
          <path class="naehte__kordel" d={kordel} />
          {oesen.map((p) => (
            <polygon class="naehte__oese" points={p} />
          ))}
        </g>

        <g
          class="ebene"
          data-ebene="etikett"
          style={`--zu:${versatz.etikett}px`}
        >
          <g transform={etikettMatrix} class="schild">
            <rect x="0" y="0" width={etikett.b} height={etikett.h} rx="1" />
            {qrModule.map((m) => (
              <rect
                class="schild__qr"
                x={m.x}
                y={m.y}
                width="2.7"
                height="2.7"
              />
            ))}
            <rect class="schild__zeile" x="25" y="5" width="18" height="2.2" />
            <rect class="schild__zeile" x="25" y="11" width="13" height="2.2" />
            <rect class="schild__zeile" x="25" y="17" width="16" height="2.2" />
          </g>
        </g>
      </svg>

      {pilot.komponenten.map((k) => (
        <button
          type="button"
          class="hotspot"
          data-komponente={k.id}
          style={hotspotPos[k.id]}
          aria-label={t(k.name)}
        >
          <span>{k.nummer}</span>
        </button>
      ))}
    </div>
  )
}
