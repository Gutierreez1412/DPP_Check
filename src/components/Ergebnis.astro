---
import fragenDaten from "../../inhalte/fragen.json";
import ampel from "../../inhalte/ampel.json";
import seite from "../../inhalte/seite.json";
import Beratungsformular from "./Beratungsformular.astro";

interface Props {
  lang: "de" | "en";
  gruppe: { id: string; name: Record<"de" | "en", string> };
}

const { lang, gruppe } = Astro.props;
const t = (feld: Record<"de" | "en", string>) => feld[lang];
const e = seite.ergebnis;
const stufenIds = ["gruen", "gelb", "rot"] as const;

const pilotDateien = import.meta.glob("../../inhalte/gruppen/*/pilot.json");
const hatPilot = Object.keys(pilotDateien).some((pfad) =>
  pfad.includes(`/gruppen/${gruppe.id}/`),
);

// Tacho: Halbkreis in drei gleich großen Segmenten. Die Nadel zeigt bewusst
// auf die Mitte des Segments, nicht auf den genauen Punktwert (der Gesamtscore
// wird laut PROJEKT.md nicht angezeigt).
const mx = 120;
const my = 120;
const radius = 96;
const luecke = 2.5;
const punkt = (grad: number) => {
  const rad = (grad * Math.PI) / 180;
  return `${(mx + radius * Math.cos(rad)).toFixed(2)} ${(my - radius * Math.sin(rad)).toFixed(2)}`;
};
const segmente = stufenIds.map((id, i) => {
  const start = 180 - i * 60 - (i === 0 ? 0 : luecke);
  const ende = 180 - (i + 1) * 60 + (i === 2 ? 0 : luecke);
  return {
    id,
    pfad: `M ${punkt(start)} A ${radius} ${radius} 0 0 1 ${punkt(ende)}`,
  };
});

// Begründungen je Frage: ein Fakt aus der Rechtsgrundlage der Produktgruppe
// plus ein Satz zum Aufwand je Stufe (bei Datenfragen meist gemeinsam über
// "daten_aufwand"). Fehlt die Datei für eine Gruppe, erscheinen nur Stufe und
// Antwort.
type Text = Record<"de" | "en", string>;
type AufwandJeStufe = Record<"gruen" | "gelb" | "rot", Text>;
interface Begruendungen {
  rechtsgrundlage: Text;
  quelle: string;
  daten_intro?: Text;
  daten_aufwand?: AufwandJeStufe;
  fragen: Record<
    string,
    {
      fakt: Text;
      // Abweichende Punktwerte je Antwort-ID für diese Gruppe, z. B. wenn der
      // Rechtsakt noch weit entfernt ist und kein "hoher Handlungsbedarf" entsteht.
      scores?: Record<string, number>;
      aufwand?: AufwandJeStufe;
      aufwand_zuerst?: boolean;
      bezug: Text;
      quelle: string;
    }
  >;
}
const begruendungsDateien = import.meta.glob<Begruendungen>(
  "../../inhalte/gruppen/*/begruendungen.json",
  { eager: true, import: "default" },
);
const begruendungen = Object.entries(begruendungsDateien).find(([pfad]) =>
  pfad.includes(`/gruppen/${gruppe.id}/`),
)?.[1];

const texteFuerClient = {
  gruppeId: gruppe.id,
  gruppenName: t(gruppe.name),
  schwellen: ampel.schwellen,
  schwellenJeFrage: ampel.schwellen_je_frage,
  ihreAntwort: t(e.ihre_antwort),
  stufen: Object.fromEntries(
    stufenIds.map((id) => [
      id,
      {
        kurz: t(ampel.stufen[id].kurz),
        titel: t(ampel.stufen[id].titel),
        erklaerung: t(ampel.stufen[id].erklaerung),
      },
    ]),
  ),
  fragen: fragenDaten.fragen.map((f) => {
    const b = begruendungen?.fragen[f.id];
    const aufwand =
      b?.aufwand ??
      (f.bereich === "daten" ? begruendungen?.daten_aufwand : undefined);
    return {
      text: t(f.text),
      bereich: f.bereich,
      kategorie: t(f.kategorie),
      begruendung: b
        ? {
            fakt: t(b.fakt),
            aufwand: aufwand
              ? Object.fromEntries(stufenIds.map((id) => [id, t(aufwand[id])]))
              : null,
            aufwandZuerst: b.aufwand_zuerst ?? false,
            bezug: t(b.bezug),
            quelle: b.quelle,
          }
        : null,
      antworten: f.antworten.map((a) => ({
        id: a.id,
        text: t(a.text),
        score: b?.scores?.[a.id] ?? a.score,
      })),
    };
  }),
  mail: {
    titel: t(e.mail_titel),
    einstufung: t(e.mail_einstufung),
    punkte: t(e.mail_punkte),
    antworten: t(e.mail_antworten),
  },
};
---

<section class="ergebnis">
  <div class="hinweisbox ergebnis__fehlt" id="ergebnis-fehlt" hidden>
    <p>{t(e.keine_antworten)}</p>
    <a class="button" href={`/${lang}/check/${gruppe.id}/`}>{t(e.zum_check)}</a>
  </div>

  <div class="ergebnis-karte" id="ergebnis-karte" hidden>
    <div class="ergebnis-karte__haupt">
      <p class="ergebnis-karte__eyebrow">
        {t(e.eyebrow)}
      </p>

      <div class="tacho">
        <svg viewBox="0 0 240 132" aria-hidden="true" focusable="false">
          <path
            class="tacho__spur"
            d={`M ${punkt(180)} A ${radius} ${radius} 0 0 1 ${punkt(0)}`}
          ></path>
          {
            segmente.map((s, i) => (
              <path
                class={`tacho__segment tacho__segment--${s.id}`}
                d={s.pfad}
                pathLength="100"
                style={`--i:${i}`}
              />
            ))
          }
          <g class="tacho__zeiger" id="tacho-zeiger">
            <line x1={mx} y1={my} x2={mx} y2={my - radius + 18}></line>
            <circle cx={mx} cy={my} r="7"></circle>
          </g>
        </svg>
        <div class="tacho__mitte">
          <span class="tacho__label">{t(e.skala_label)}</span>
          <strong class="tacho__stufe" id="tacho-stufe"></strong>
        </div>
        <ol class="tacho__legende" aria-hidden="true">
          {
            stufenIds.map((id) => (
              <li data-id={id}>{t(ampel.stufen[id].kurz)}</li>
            ))
          }
        </ol>
      </div>

      <h1 class="ergebnis-karte__titel" id="ergebnis-titel"></h1>
      <p class="ergebnis-karte__text" id="ergebnis-text"></p>

      <div class="ergebnis-karte__aktionen">
        <a class="button button--hell" href="#beratung"
          >{t(e.beratung_button)}</a
        >
        <a
          class="ergebnis-karte__link"
          id="ergebnis-aendern"
          href={`/${lang}/check/${gruppe.id}/`}>{t(e.antworten_aendern)}</a
        >
      </div>
    </div>

    <aside class="begruendung" aria-labelledby="begruendung-titel">
      <h2 class="begruendung__titel" id="begruendung-titel">
        {t(e.begruendung_titel)}
      </h2>
      {
        begruendungen && (
          <p class="begruendung__intro">
            {t(e.begruendung_bezug)}{" "}
            <a href={begruendungen.quelle} target="_blank" rel="noopener">
              {t(begruendungen.rechtsgrundlage)}
            </a>
            .
          </p>
        )
      }

      <section class="begruendung__block">
        <h3 class="begruendung__blocktitel">{t(e.rahmen_titel)}</h3>
        <ol class="begruendung__liste" id="begruendung-rahmen"></ol>
      </section>

      <section class="begruendung__block">
        <h3 class="begruendung__blocktitel">{t(e.daten_titel)}</h3>
        <p class="begruendung__blockintro">
          {t(begruendungen?.daten_intro ?? e.daten_intro)}
        </p>
        <ol class="begruendung__liste" id="begruendung-daten"></ol>
      </section>
    </aside>

    {
      hatPilot && (
        <a
          class="ergebnis-karte__pilot"
          id="ergebnis-pilot"
          href={`/${lang}/pilot/${gruppe.id}/`}
        >
          <span class="ergebnis-karte__pilot-qr" aria-hidden="true" />
          <span class="ergebnis-karte__pilot-text">{t(e.pilot_link)}</span>
          <span class="ergebnis-karte__pilot-pfeil" aria-hidden="true">
            →
          </span>
        </a>
      )
    }

    <template id="begruendung-vorlage">
      <li class="begruendung__punkt">
        <details>
          <summary class="begruendung__kopf">
            <span class="begruendung__kategorie"></span>
            <span class="begruendung__stufe"></span>
          </summary>
          <p class="begruendung__warum">
            <span></span>
            <a target="_blank" rel="noopener"></a>
          </p>
        </details>
      </li>
    </template>
  </div>

  <p class="ergebnis__hinweis">{t(ampel.hinweis)}</p>

  <Beratungsformular lang={lang} gruppenName={t(gruppe.name)} mitErgebnis />

  <p class="check__zurueck">
    <a href={`/${lang}/gruppe/${gruppe.id}/`}>{t(seite.zurueck_zur_gruppe)}</a>
  </p>
</section>

<script
  type="application/json"
  id="ergebnis-texte"
  set:html={JSON.stringify(texteFuerClient)}
/>

<script>
  interface Antwort {
    id: string;
    text: string;
    score: number;
  }
  interface Frage {
    text: string;
    bereich: "rahmen" | "daten";
    kategorie: string;
    begruendung: {
      fakt: string;
      aufwand: Record<string, string> | null;
      aufwandZuerst: boolean;
      bezug: string;
      quelle: string;
    } | null;
    antworten: Antwort[];
  }

  // Ampelstufe einer einzelnen Antwort (Schwellen aus ampel.json).
  function stufeFuer(
    score: number,
    s: { gruen_max: number; gelb_max: number },
  ) {
    return score <= s.gruen_max
      ? "gruen"
      : score <= s.gelb_max
        ? "gelb"
        : "rot";
  }

  // Begründungen in zwei Blöcken (Rahmenbedingungen, Produktdaten), innerhalb
  // eines Blocks höchster Handlungsbedarf zuerst.
  function fuelleBegruendungen(
    texte: any,
    fragen: Frage[],
    antworten: Antwort[],
  ) {
    const vorlage = document.getElementById("begruendung-vorlage");
    if (!(vorlage instanceof HTMLTemplateElement)) return;

    const reihenfolge = fragen
      .map((f, i) => ({ frage: f, antwort: antworten[i] }))
      .sort((a, b) => b.antwort.score - a.antwort.score);

    reihenfolge.forEach(({ frage, antwort }, j) => {
      const liste = document.getElementById(`begruendung-${frage.bereich}`);
      if (!liste) return;
      const el = vorlage.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLElement;
      const stufeId = stufeFuer(antwort.score, texte.schwellenJeFrage);
      const feld = (klasse: string) =>
        el.querySelector(`.begruendung__${klasse}`) as HTMLElement;

      el.dataset.stufe = stufeId;
      el.style.setProperty("--j", String(j));
      feld("kategorie").textContent = frage.kategorie;
      feld("stufe").textContent = texte.stufen[stufeId].kurz;

      // Ein Absatz: Fakt aus der Verordnung und was er bei dieser Antwort für den
      // Aufwand bedeutet, am Ende klein der Artikel. Ohne Begründungsdatei steht
      // dort nur die gewählte Antwort.
      const text = feld("warum").querySelector("span")!;
      const link = feld("warum").querySelector("a")!;
      if (frage.begruendung) {
        const { fakt, aufwand, aufwandZuerst, bezug, quelle } =
          frage.begruendung;
        const saetze = [fakt, aufwand?.[stufeId] ?? ""];
        if (aufwandZuerst) saetze.reverse();
        text.textContent = `${saetze.join(" ").trim()} `;
        link.href = quelle;
        link.textContent = bezug;
      } else {
        text.textContent = `${texte.ihreAntwort}: ${antwort.text}`;
        link.remove();
      }
      liste.append(el);
    });
  }

  function initErgebnis() {
    const texteEl = document.getElementById("ergebnis-texte");
    const karte = document.getElementById("ergebnis-karte");
    const fehlt = document.getElementById("ergebnis-fehlt");
    if (!texteEl || !karte || !fehlt) return;
    const texte = JSON.parse(texteEl.textContent || "{}");
    const fragen: Frage[] = texte.fragen;

    // Antworten stehen im Adress-Anker (#a=a-b-c…). Der Teil hinter "#" wird
    // nie an einen Server übertragen, die Daten bleiben also im Browser.
    const ids =
      new URLSearchParams(window.location.hash.slice(1)).get("a")?.split("-") ??
      [];
    const gewaehlt = fragen.map((f, i) =>
      f.antworten.find((a) => a.id === ids[i]),
    );

    if (gewaehlt.some((a) => !a)) {
      fehlt.hidden = false;
      document.getElementById("b-ergebnis-zeile")?.setAttribute("hidden", "");
      return;
    }

    const antworten = gewaehlt as Antwort[];
    const summe = antworten.reduce((s, a) => s + a.score, 0);
    const max = fragen.reduce(
      (s, f) => s + Math.max(...f.antworten.map((a) => a.score)),
      0,
    );
    const stufeId = stufeFuer(summe, texte.schwellen);
    const stufe = texte.stufen[stufeId];
    fuelleBegruendungen(texte, fragen, antworten);

    karte.dataset.stufe = stufeId;
    document.getElementById("tacho-stufe")!.textContent = stufe.kurz;
    document.getElementById("ergebnis-titel")!.textContent = stufe.titel;
    document.getElementById("ergebnis-text")!.textContent = stufe.erklaerung;
    const aendern = document.getElementById("ergebnis-aendern");
    if (aendern instanceof HTMLAnchorElement)
      aendern.hash = `a=${ids.join("-")}`;
    // Antworten zum Pilot mitgeben, damit der Rückweg zum Ergebnis funktioniert.
    const pilot = document.getElementById("ergebnis-pilot");
    if (pilot instanceof HTMLAnchorElement) pilot.hash = `a=${ids.join("-")}`;

    // Inhalt für die Mail, falls im Beratungsformular "Ergebnis mitsenden"
    // angehakt wird.
    const zeilen = [
      `${texte.mail.titel}:`,
      `${texte.mail.einstufung}: ${stufe.titel}`,
      `${texte.mail.punkte}: ${summe} / ${max}`,
      "",
      `${texte.mail.antworten}:`,
      ...fragen.map((f, i) => `${i + 1}. ${f.text}\n   → ${antworten[i].text}`),
    ];
    const formular = document.getElementById("beratung-form");
    if (formular) formular.dataset.ergebnis = JSON.stringify(zeilen);

    // Animation starten: Segmente zeichnen, Nadel schwingt ein, Stufe leuchtet.
    const winkel = { gruen: -60, gelb: 0, rot: 60 }[stufeId];
    const zeiger = document.getElementById("tacho-zeiger");
    karte.hidden = false;

    // Versatz messen, um den das Ergebnis vor dem Aufteilen in die Kartenmitte
    // geschoben wird (nur im zweispaltigen Layout ab 900px). Beim ersten Setzen
    // ohne Übergang, damit nichts sichtbar hin- und herrutscht.
    const haupt = karte.querySelector<HTMLElement>(".ergebnis-karte__haupt");
    const zweispaltig = window.matchMedia("(min-width: 900px)");
    const setzeVersatz = () => {
      const versatz =
        haupt && zweispaltig.matches
          ? karte.clientWidth / 2 - (haupt.offsetLeft + haupt.offsetWidth / 2)
          : 0;
      karte.style.setProperty("--versatz", `${versatz}px`);
    };
    if (haupt) haupt.style.transition = "none";
    setzeVersatz();
    void karte.offsetWidth;
    if (haupt) haupt.style.transition = "";
    window.addEventListener("resize", setzeVersatz);
    requestAnimationFrame(() => {
      karte.classList.add("ist-sichtbar");
      if (zeiger) zeiger.style.transform = `rotate(${winkel}deg)`;
    });

    // Danach rückt das Ergebnis nach links und die Begründungen erscheinen
    // rechts (auf schmalen Bildschirmen darunter).
    const ruhig = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    window.setTimeout(
      () => karte.classList.add("ist-aufgeteilt"),
      ruhig ? 0 : 3000,
    );
  }

  initErgebnis();
</script>
