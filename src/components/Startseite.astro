---
import { Image } from "astro:assets";
import seite from "../../inhalte/seite.json";
import GrundlagenUebersicht from "./GrundlagenUebersicht.astro";
import Beratungsformular from "./Beratungsformular.astro";
import heroBild from "../assets/hero-dpp.png";

interface Props {
  lang: "de" | "en";
}

const { lang } = Astro.props;
const start = seite.startseite;
---

<section class="hero hero-start">
  <div class="wrap hero-start__innen">
    <div class="hero-start__text">
      <span class="tag tag-stand">{start.hero.kicker[lang]}</span>
      <h1>{start.hero.ueberschrift[lang]}</h1>
      <p class="lead">{start.hero.unterzeile[lang]}</p>
      <div class="hero-start__aktion">
        <a class="button button--gross" href={start.cta.link[lang]}
          >{start.cta.text[lang]} →</a
        >
        <span class="hero-start__fakt">{start.hero.fakt[lang]}</span>
      </div>
    </div>
    <Image
      class="hero-start__bild"
      src={heroBild}
      alt=""
      width={1920}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<section class="section" id="ueber">
  <div class="wrap">
    <ul class="nutzen__liste">
      {
        start.nutzen.map((punkt, i) => (
          <li class={i === 1 ? "card-inverse" : "card"}>
            <span class="tag">{`0${i + 1}`}</span>
            <h2>{punkt.titel[lang]}</h2>
            <p class={i === 1 ? "" : "muted"}>{punkt.text[lang]}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<div class="section section-alt" id="grundlagen">
  <div class="wrap">
    <GrundlagenUebersicht lang={lang} />
  </div>
</div>

<section class="section start-abschluss">
  <div class="wrap">
    <hr class="rule-gradient" />
    <div class="start-abschluss__innen">
      <div>
        <h2>{start.cta_band.ueberschrift[lang]}</h2>
        <p class="muted">{start.cta_band.text[lang]}</p>
      </div>
      <a class="button button--gross" href={start.cta.link[lang]}
        >{start.cta.text[lang]} →</a
      >
    </div>
    <p class="start-hinweis">{start.hinweis[lang]}</p>
  </div>
</section>

<div class="wrap start-kontakt">
  <Beratungsformular lang={lang} mitPerson />
</div>
