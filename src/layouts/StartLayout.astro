---
import "../styles/global.css";
import "../styles/landing.css";
import seite from "../../inhalte/seite.json";
import logoInk from "../assets/fr-logo-ink.svg?raw";
import logoInverse from "../assets/fr-logo-inverse.svg?raw";

interface Props {
  lang: "de" | "en";
  title?: string;
  /** Unterseite: Pille ohne Anker-Links und ohne Check-Button */
  schlicht?: boolean;
  /** Kleingedrucktes im Footer (z. B. Disclaimer) */
  fusshinweis?: string;
  /** Unterseite: Ziel des Buttons rechts in der Pille (Standard: Startseite) */
  zurueck?: { href: string; label: string };
}

const { lang, title, schlicht = false, fusshinweis, zurueck } = Astro.props;
const start = seite.startseite;
const startLink = `/${lang}/`;
const seitentitel = title
  ? `${title} – ${start.seitentitel[lang]}`
  : start.seitentitel[lang];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{seitentitel}</title>
  </head>
  <body class="landing">
    <header class="start-kopf">
      <div class="wrap">
        <nav class="nav-pill" aria-label="Navigation">
          <a
            class="start-logo"
            href={startLink}
            aria-label={`Future Response – ${start.logo.alt[lang]}`}
          >
            <span class="start-logo__fr" set:html={logoInk} />
            <span class="start-logo__produkt"
              >{start.logo.beschriftung[lang]}</span
            >
          </a>
          {
            !schlicht ? (
              <>
                <a class="nav-link nav-link--mobil-aus" href="#ueber">
                  {start.nav.ueber[lang]}
                </a>
                <a class="nav-link nav-link--mobil-aus" href="#grundlagen">
                  {start.nav.grundlagen[lang]}
                </a>
                <a class="button" href={start.cta.link[lang]}>
                  {start.nav.cta[lang]}
                </a>
              </>
            ) : (
              <a class="button button--ghost" href={zurueck?.href ?? startLink}>
                {zurueck?.label ?? seite.zur_startseite[lang]}
              </a>
            )
          }
        </nav>
      </div>
    </header>

    <main class="start-haupt">
      <slot />
    </main>

    <footer class="footer start-fuss">
      <div class="wrap start-fuss__innen">
        <span class="start-fuss__logo" set:html={logoInverse} />
        <nav
          class="start-fuss__links"
          aria-label={lang === "de" ? "Rechtliches" : "Legal"}
        >
          <a href={start.footer.impressum.link}
            >{start.footer.impressum.text[lang]}</a
          >
          <a href={start.footer.datenschutz.link}
            >{start.footer.datenschutz.text[lang]}</a
          >
        </nav>
        {fusshinweis && <p class="start-fuss__hinweis">{fusshinweis}</p>}
      </div>
    </footer>
  </body>
</html>
